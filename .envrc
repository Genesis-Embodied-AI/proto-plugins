dotenv_if_exists .env

export PROTO_TRUSTED_PATHS="$PWD${PROTO_TRUSTED_PATHS:+:$PROTO_TRUSTED_PATHS}"

# Auto-install the proto-pinned toolchain on entry and expose it on PATH.
# Requires proto (https://moonrepo.dev/proto) and direnv to be installed.
if ! has proto; then
  log_error "proto not found; install it: https://moonrepo.dev/docs/proto/install"
else
  # Ensure that the installed version is above our declared version floor.
  proto_floor="$(sed -n 's/^proto = ">=\(.*\)"$/\1/p' .prototools)"
  proto_version="$(proto --version | cut -d' ' -f2)"
  if [ -n "$proto_floor" ] &&
    [ "$(printf '%s\n%s\n' "$proto_floor" "$proto_version" | sort -V | head -1)" != "$proto_floor" ]; then
    log_error "proto $proto_version is older than the $proto_floor required by .prototools; run: proto upgrade"
  else
    proto use
  fi
  unset proto_floor proto_version

  PATH_add "${PROTO_HOME:-$HOME/.proto}/shims"
  PATH_add "${PROTO_HOME:-$HOME/.proto}/bin"
fi
